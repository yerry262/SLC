# Public depositor/deployer address — used to discover validators via
# beaconcha.in's /validator/eth1/{address} (phase 2) or by cross-referencing
# local node deposit-contract logs (phase 1). Public on-chain info.
DEPOSIT_ADDRESS=0x95aed4dc9acc614415d3bc56711998b8041878eb

# beaconcha.in API key. GitHub Actions secret only — do not put a real value
# here or commit .env. Currently zero-quota (no active plan on the account).
BEACONCHAIN_API=

# Home node address, read by every scripts/fetch_*.py that talks to the
# node (fetch_fleet.py, fetch_earnings.py, fetch_performance.py,
# fetch_wallets.py, fetch_blocks.py). Two valid paths depending on where
# the script runs from:
#   - Over WireGuard (ethereum-wg), off-LAN: 10.44.0.4 (the default if unset)
#   - Direct on the home LAN: yerry.local
NODE_IP=10.44.0.4

# Optional: use CoinMarketCap instead of CoinGecko for the ETH/USD price in
# scripts/fetch_price.py. Must be a freshly-issued key — never reuse the one
# that leaked into SLC-DASHBOARD-2024's git history (see MIGRATE.md).
COINMARKETCAP_API=
